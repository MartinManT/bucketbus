<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BucketBus.Desktop.ViewModels"
        xmlns:design="using:BucketBus.Desktop.Design"
        xmlns:local="using:BucketBus.Desktop"
        x:Class="BucketBus.Desktop.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="BucketBus" Width="1180" Height="760" MinWidth="850" MinHeight="680"
        Design.DataContext="{x:Static design:DesignData.Preview}">
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="16" RowSpacing="8">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="3">
        <TextBlock Text="BucketBus" FontSize="26" FontWeight="SemiBold" />
        <TextBlock Classes="secondary" Text="Local files and S3 storage" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <Button x:Name="SettingsButton" Content="Settings" AutomationProperties.Name="Display settings">
          <Button.Flyout><Flyout>
            <StackPanel x:Name="SettingsPanel" DataContext="{Binding Settings}" x:DataType="vm:SettingsViewModel" Width="300" Spacing="8">
              <TextBlock Text="Display settings" FontWeight="SemiBold" />
              <TextBlock Text="File size display" />
              <ComboBox x:Name="FileSizePreference" ItemsSource="{Binding FileSizeOptions}" SelectedItem="{Binding FileSizes}" HorizontalAlignment="Stretch" AutomationProperties.Name="File size display">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{ReflectionBinding Converter={StaticResource PreferenceLabel}}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="Remote object names" />
              <ComboBox x:Name="RemoteNamePreference" ItemsSource="{Binding RemoteNameOptions}" SelectedItem="{Binding RemoteNames}" HorizontalAlignment="Stretch" AutomationProperties.Name="Remote object names">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{ReflectionBinding Converter={StaticResource PreferenceLabel}}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
              <Button x:Name="SavePreferences" Content="Save preferences" Command="{Binding SaveCommand}" />
            </StackPanel>
          </Flyout></Button.Flyout>
        </Button>
        <Button Content="Profiles" Command="{Binding ShowProfilesCommand}" />
        <TextBlock Text="Pre-alpha · Sequential transfers" />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1" Spacing="8">
      <ProgressBar x:Name="StartupProgress" Height="3" IsIndeterminate="True"
                   IsVisible="{Binding IsLoading}" AutomationProperties.Name="Starting BucketBus" />
      <Border x:Name="StartupError" IsVisible="{Binding HasError}" Padding="12" CornerRadius="4"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" BorderThickness="1">
        <StackPanel Spacing="4">
          <TextBlock Text="BucketBus could not finish starting." FontWeight="SemiBold" />
          <TextBlock Text="Close the application and try again. Error code: BB-STARTUP." TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>

    <Grid Grid.Row="2" ColumnDefinitions="*,12,*" IsVisible="{Binding !ProfilesVisible}">
      <Border x:Name="LocalPane" Classes="pane" Padding="16" MinWidth="280"
              AutomationProperties.Name="Local files pane">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
          <TextBlock Text="LOCAL" FontWeight="SemiBold" />
          <TextBox x:Name="LocalLocation" Grid.Row="1" Text="{Binding Local.PathInput}"
                   PlaceholderText="Absolute directory path" ToolTip.Tip="Enter an absolute directory path and press Enter." AutomationProperties.Name="Local location" TabIndex="0" />
          <Border x:Name="LocalContent" Grid.Row="2" Focusable="True" TabIndex="1"
                  AutomationProperties.Name="Local filesystem browser">
            <local:LocalBrowserView x:Name="LocalView" DataContext="{Binding Local}" />
          </Border>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Resize file panes" TabIndex="2" />
      <Border x:Name="RemotePane" Grid.Column="2" Classes="pane" Padding="16" MinWidth="280"
              AutomationProperties.Name="Remote storage pane">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
          <TextBlock Text="REMOTE" FontWeight="SemiBold" />
          <TextBox x:Name="RemoteLocation" Grid.Row="1" IsReadOnly="True" Text="{Binding Browser.Location}"
                   AutomationProperties.Name="Remote location" TabIndex="3" />
          <Border x:Name="RemoteContent" Grid.Row="2" Focusable="True" TabIndex="4"
                  AutomationProperties.Name="Remote storage browser">
            <local:RemoteBrowserView x:Name="BrowserView" DataContext="{Binding Browser}" />
          </Border>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="2" IsVisible="{Binding ProfilesVisible}" RowDefinitions="Auto,*" RowSpacing="8">
      <Button Content="Back to panes" Command="{Binding CloseProfilesCommand}" />
      <local:ProfileManagementView Grid.Row="1" DataContext="{Binding Profiles}" />
    </Grid>

    <Border Grid.Row="3" Padding="16" CornerRadius="6" BorderThickness="1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="Transfers" FontWeight="SemiBold" /><TextBlock Text="{Binding Transfers.QueueSummary}" Classes="secondary" /></StackPanel>
        <TextBlock x:Name="UploadProviderNotice" Classes="secondary" Text="Upload collision protection depends on the provider honoring create-only requests." TextWrapping="Wrap" />
        <WrapPanel Orientation="Horizontal">
          <Button x:Name="UploadFile" Content="Add selected uploads (Ctrl+U)" Margin="0,0,6,0" IsEnabled="{Binding !ProfilesVisible}" Command="{Binding Transfers.UploadCommand}" />
          <Button x:Name="DownloadFile" Content="Add selected downloads (Ctrl+D)" Margin="0,0,6,0" IsEnabled="{Binding !ProfilesVisible}" Command="{Binding Transfers.DownloadCommand}" />
          <Button Content="Start / Continue" Command="{Binding Transfers.StartQueueCommand}" Margin="0,0,6,0" />
          <Button Content="Pause after current" Command="{Binding Transfers.PauseQueueCommand}" Margin="0,0,6,0" />
          <Button x:Name="CancelTransfer" Content="Cancel active" Command="{Binding Transfers.CancelCommand}" />
        </WrapPanel>
        <TextBlock Text="{Binding Transfers.Source}" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Transfers.Destination}" TextTrimming="CharacterEllipsis" />
        <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding Transfers.Percent}" IsVisible="{Binding Transfers.IsBusy}" />
        <TextBlock Text="{Binding Transfers.Bytes}" ToolTip.Tip="{Binding Transfers.ExactBytes}" />
        <TextBlock x:Name="TransferStatus" Text="{Binding Transfers.Status}" TextWrapping="Wrap" />
        <Expander x:Name="TransferHistoryPanel" Header="Transfer queue, history and recovery" HorizontalAlignment="Stretch">
          <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="5">
            <TextBlock Text="{Binding Transfers.HistoryStatus}" TextWrapping="Wrap" />
            <ListBox x:Name="TransferHistory" ItemsSource="{Binding Transfers.History}" SelectedItem="{Binding Transfers.SelectedHistory}" MaxHeight="100">
              <ListBox.ItemTemplate><DataTemplate x:DataType="vm:TransferHistoryRow"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <ScrollViewer MaxHeight="100"><TextBlock Text="{Binding Transfers.RecoveryDetails}" TextWrapping="Wrap" /></ScrollViewer>
            <CheckBox Content="Confirm whole-file download restart (current remote content)" IsChecked="{Binding Transfers.ConfirmRestart}" />
            <CheckBox Content="Confirm the selected multipart resume or abort action" IsChecked="{Binding Transfers.ConfirmMultipart}" />
            <CheckBox Content="Allow vault unlock prompt for queue and recovery" IsChecked="{Binding Transfers.AllowRecoveryUnlock}" />
            <WrapPanel Orientation="Horizontal">
              <Button Content="Remove queued job" Command="{Binding Transfers.RemoveQueuedCommand}" />
              <Button Content="Reload history" Command="{Binding Transfers.ReloadHistoryCommand}" />
              <Button Content="Reconcile upload" Command="{Binding Transfers.ReconcileCommand}" />
              <Button Content="Restart download" Command="{Binding Transfers.RestartCommand}" />
              <Button Content="Resume multipart upload" Command="{Binding Transfers.ResumeMultipartCommand}" />
              <Button Content="Abort incomplete upload" Command="{Binding Transfers.AbortMultipartCommand}" />
              <Button Content="Dismiss resolved" Command="{Binding Transfers.DismissCommand}" />
            </WrapPanel>
          </StackPanel>
          </ScrollViewer>
        </Expander>
      </StackPanel>
    </Border>

    <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
      <TextBlock x:Name="ShellStatus" Classes="secondary" Text="{Binding StatusMessage}" />
      <TextBlock Grid.Column="1" Classes="secondary" Text="Ctrl+Tab  Switch pane     Ctrl+L  Focus location" />
    </Grid>
  </Grid>
</Window>
