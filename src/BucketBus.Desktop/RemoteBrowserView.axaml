<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:BucketBus.Desktop" xmlns:vm="using:BucketBus.Desktop.ViewModels" xmlns:core="using:BucketBus.Core"
             x:Class="BucketBus.Desktop.RemoteBrowserView" x:DataType="vm:RemoteBrowserViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="4">
    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="4">
      <ComboBox x:Name="BrowserProfiles" ItemsSource="{Binding ProfilesList}" SelectedItem="{Binding SelectedProfile}"
                HorizontalAlignment="Stretch" PlaceholderText="Select a profile" AutomationProperties.Name="Connection profile">
        <ComboBox.ItemTemplate><DataTemplate x:DataType="core:ConnectionProfile"><TextBlock Text="{Binding Settings.Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Settings.Name}" /></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
      <Button Grid.Column="1" x:Name="ConnectButton" Content="Connect" Command="{Binding ConnectCommand}" />
      <CheckBox Grid.Column="2" x:Name="VaultConsent" Content="Unlock" ToolTip.Tip="Allow vault unlock prompt for Connect" IsChecked="{Binding AllowUnlock}" AutomationProperties.Name="Allow vault unlock prompt" />
      <Button Grid.Column="3" Content="↻" ToolTip.Tip="Refresh (Ctrl+R)" AutomationProperties.Name="Refresh remote listing" Command="{Binding RefreshCommand}" />
      <Button Grid.Column="4" Content="⋯" AutomationProperties.Name="Connection actions">
        <Button.Flyout><MenuFlyout>
          <MenuItem Header="Reload profiles" Command="{Binding ReloadProfilesCommand}" />
          <MenuItem Header="Disconnect" Command="{Binding DisconnectCommand}" />
          <MenuItem Header="Cancel request" Command="{Binding CancelCommand}" />
        </MenuFlyout></Button.Flyout>
      </Button>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="Auto,2*,3*,Auto" ColumnSpacing="4">
      <Button Content="Up" Command="{Binding UpCommand}" />
      <TextBox Grid.Column="1" x:Name="BucketInput" Text="{Binding BucketInput}" PlaceholderText="Bucket (empty = discover)" AutomationProperties.Name="Bucket to browse" ToolTip.Tip="{Binding BucketInput}" />
      <TextBox Grid.Column="2" x:Name="PrefixInput" Text="{Binding PrefixInput}" PlaceholderText="Exact prefix" AutomationProperties.Name="Exact S3 prefix" ToolTip.Tip="{Binding PrefixInput}" />
      <Button Grid.Column="3" x:Name="GoButton" Content="Go" Command="{Binding GoCommand}" />
    </Grid>
    <StackPanel Grid.Row="2" Spacing="2">
      <ProgressBar x:Name="BrowserProgress" Height="3" IsIndeterminate="True" IsVisible="{Binding IsBusy}" AutomationProperties.Name="Loading storage" />
      <TextBlock x:Name="BrowserStatus" Text="{Binding Status}" TextWrapping="Wrap" />
      <local:FileColumnsGrid Classes="fileColumns">
        <TextBlock Text="Name / key" /><TextBlock Grid.Column="1" Text="Size" />
        <TextBlock Classes="detailColumn" Grid.Column="2" Text="Modified" /><TextBlock Classes="detailColumn" Grid.Column="3" Text="Type" />
      </local:FileColumnsGrid>
    </StackPanel>
    <ListBox Grid.Row="3" x:Name="ObjectList" Focusable="True" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" SelectedItems="{Binding SelectedRows, Mode=OneWay}" SelectionMode="Multiple"
             MinHeight="80" AutomationProperties.Name="Remote buckets, prefixes and objects"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ContextMenu><ContextMenu>
        <MenuItem Header="Open" Command="{Binding OpenCommand}" />
        <MenuItem Header="Properties" Command="{Binding PropertiesCommand}" InputGesture="Alt+Enter" />
        <MenuItem Header="Download selected objects" x:Name="DownloadContextItem" />
        <Separator /><MenuItem Header="Refresh" Command="{Binding RefreshCommand}" />
      </ContextMenu></ListBox.ContextMenu>
      <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.Styles>
      <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:BrowserRow">
          <local:FileColumnsGrid Classes="fileColumns" ColumnSpacing="4" ToolTip.Tip="{Binding Details}">
            <TextBlock TextTrimming="CharacterEllipsis" MinWidth="80">
              <TextBlock.Text><MultiBinding Converter="{StaticResource RemoteName}">
                <Binding Path="Key" /><Binding Path="Kind" />
                <ReflectionBinding Path="DataContext.ActivePrefix" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type UserControl}}" />
                <ReflectionBinding Path="DataContext.Display.Current" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type UserControl}}" />
              </MultiBinding></TextBlock.Text>
            </TextBlock>
            <TextBlock Grid.Column="1" ToolTip.Tip="{Binding ExactSize}" TextTrimming="CharacterEllipsis">
              <TextBlock.Text><MultiBinding Converter="{StaticResource SizeDisplay}">
                <Binding Path="Size" /><ReflectionBinding Path="DataContext.Display.Current" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type UserControl}}" /><Binding Path="Kind" />
              </MultiBinding></TextBlock.Text>
            </TextBlock>
            <TextBlock Classes="detailColumn" Grid.Column="2" Text="{Binding ModifiedText}" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="detailColumn" Grid.Column="3" Text="{Binding Type}" />
          </local:FileColumnsGrid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="4">
      <Button x:Name="PreviousPage" Content="←" ToolTip.Tip="Previous cached page" AutomationProperties.Name="Previous cached page" Command="{Binding PreviousCommand}" />
      <Button Grid.Column="1" x:Name="NextPage" Content="→" ToolTip.Tip="Next page" AutomationProperties.Name="Next page" Command="{Binding NextCommand}" />
      <TextBlock Grid.Column="2" Text="{Binding PageSummary}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PageSummary}" VerticalAlignment="Center" />
      <Button Grid.Column="3" x:Name="PropertiesButton" Content="Properties" Command="{Binding PropertiesCommand}" />
      <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="{Binding SelectionIdentity}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectionIdentity}" />
    </Grid>
  </Grid>
</UserControl>
